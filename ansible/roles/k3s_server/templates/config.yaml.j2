# managed by ansible (homelab/ansible/roles/k3s_server). local edits will be overwritten by Ansible.

# Join secret, kept in its own root-only file so this config holds no secrets
# and can be diffed and reviewed safely
token-file: /etc/rancher/k3s/token

# Scheduled etcd snapshots. Local copies land in 
# /var/lib/rancher/k3s/server/db/snapshots
etcd-snapshot-schedule-cron: "{{ k3s_etcd_snapshot_cron }}"
etcd-snapshot-retention: {{ k3s_etcd_snapshot_retention }}
